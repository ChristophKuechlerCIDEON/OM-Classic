  <asx:values>
   <VSEOINTERF>
    <CLSNAME>/CIDEON/IF_PLOT_BO</CLSNAME>
    <LANGU>D</LANGU>
    <DESCRIPT>An den Plotdienst angeschlossenes Business Objekt</DESCRIPT>
    <EXPOSURE>2</EXPOSURE>
    <STATE>1</STATE>
    <UNICODE>X</UNICODE>
   </VSEOINTERF>
   <DESCRIPTIONS>
    <SEOCOMPOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>AQUIRE_OBJECTS !!!! Obsolet !!!</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>ACQUIRE_RELATED_OBJECTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Ermittelt die Plot Objekte, die mit diesem in Beziehung steh</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>DISPLAY</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Legt fest, ob das Objekt im Selektionsdialog angezeigt wird</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_ADDITIONAL_DATA</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Liefert die Zusatzdaten als Collection Objekt</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_ICON</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Liefert das Ikon des Objektes</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_KEY</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Erstellt bzw. Liefert den Schlüssel zur Identifizierung</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_SUPPORTED_DLTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Liefert die von Plot Objekt unterstützten Dokumentermittlung</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>GET_TEXT</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Liefert die Textrepräsentation des Objektes</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>HAS_RELATED_OBJECTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Prüft, ob es referenzierte Plot Objekte gibt.</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>NAME</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Name des Business Objekttyps wie in SWO1</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>RELATED_OBJECTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>verbundene Objekte</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>REMOVE_ALL_OBJECTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Löscht alle gefundenen Objekte m. Dokumenten</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>SET_KEY</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Setzt den Objektschlüssel</DESCRIPT>
    </SEOCOMPOTX>
    <SEOCOMPOTX>
     <CMPNAME>SUPPORTED_DLTS</CMPNAME>
     <LANGU>D</LANGU>
     <DESCRIPT>unterstützte Dokumentverknüpfungstypen</DESCRIPT>
    </SEOCOMPOTX>
   </DESCRIPTIONS>
   <DESCRIPTIONS_SUB>
    <SEOSUBCOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <SCONAME>CURRENT_LEVEL</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Aktueller Level in der BO-Struktur</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <SCONAME>DISPLAY</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Darstellung des Objektes Ja nein</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <SCONAME>NOTHING_FOUND</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Es wurden keine verarbeitbaren Objekte gefunden. !Nachricht!</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <SCONAME>PARENT_ITEM</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Übergeordnetes Tree Item</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>ACQUIRE_OBJECTS</CMPNAME>
     <SCONAME>SELECTION_TREE</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Tree Modell für Selektionsdialog</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>DISPLAY</CMPNAME>
     <SCONAME>RB_DISPLAY</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Objekt anzeigen (ja/nein)</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET_ADDITIONAL_DATA</CMPNAME>
     <SCONAME>RO_ADDITIONAL_DATA</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Zusatzdaten als Collection mit /CIDEON/CL_OO_STRING Objekten</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET_ICON</CMPNAME>
     <SCONAME>RC_ICON</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Ikone des Plot Objektes</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET_KEY</CMPNAME>
     <SCONAME>KEY</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Schlüssel</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET_SUPPORTED_DLTS</CMPNAME>
     <SCONAME>RO_DLTS</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Dokumentverknüpfungstypen</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>GET_TEXT</CMPNAME>
     <SCONAME>RC_TEXT</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Text des Plot Objektes</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>HAS_RELATED_OBJECTS</CMPNAME>
     <SCONAME>RB_HAS_RELATED_OBJECTS</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>True, wenn es referenzierte Objekte gibt</DESCRIPT>
    </SEOSUBCOTX>
    <SEOSUBCOTX>
     <CMPNAME>SET_KEY</CMPNAME>
     <SCONAME>OBJKEY</SCONAME>
     <LANGU>D</LANGU>
     <DESCRIPT>Objektschlüssel</DESCRIPT>
    </SEOSUBCOTX>
   </DESCRIPTIONS_SUB>
