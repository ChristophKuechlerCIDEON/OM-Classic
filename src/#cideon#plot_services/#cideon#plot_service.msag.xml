     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;CAUSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>In order to perform this function, you have to select order item(s).</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYSTEM_RESPONSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;WHAT_TO_DO&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Select at least one order item.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Note: Within the transactions, using not ALV Grid Controls for</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>displaying the items, you have to press ENTER key after selection. With</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>it the selection becomes active and the selected object service can be</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>performed.</TDLINE>
      </TLINE>
     </LINES>
    </item>
