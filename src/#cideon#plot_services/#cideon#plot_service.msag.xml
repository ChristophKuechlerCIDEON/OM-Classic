     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>/CIDEON/PLOT_SERVICE000</TDNAME>
      <TDID>NA</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00006</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;CAUSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Um die gewählte Funktion ausführen zu können, müssen Bestellposition(en)</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selektiert sein.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYSTEM_RESPONSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;WHAT_TO_DO&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Selektieren Sie mindestens eine Bestellposition.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Hinweis: In den Transaktionen, in denen die Tabelle nicht mit Hilfe</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>eines ALV Grid Controls dargestellt wird, muß nach der Selektion die</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ENTER Taste gedrückt werden, damit die Selektion aktiviert wird. Erst</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>danach können die Objektdienste auf die Selektion ausgeführt werden.</TDLINE>
      </TLINE>
     </LINES>
    </item>
