     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;CAUSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Sie haben versucht Dokumente in die Plotliste einzufügen. Leider sind</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>im keine entsprechenden Dokumente im Zwischenspeicher vorhanden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYSTEM_RESPONSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;WHAT_TO_DO&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Kopieren oder Schneiden sie die Dokumente, welche sie einfügen wollen,</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>nochmal aus. Und wiederholen sie Ihr Vorgehen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYS_ADMIN&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
