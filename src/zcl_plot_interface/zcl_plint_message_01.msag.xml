     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZCL_PLINT_MESSAGE_01201</TDNAME>
      <TDID>NA</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00004</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;CAUSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Zu einem oder mehreren Dokumentinfosätzen wurden keine Originaldateien</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>gefunden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die betroffenen Dokumentinfosätzte werden aufgelistet.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Das &quot;Nichtfinden&quot; von Originaldateien kann verschiedene Ursachen haben:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>1. Es existieren für den gewählten Dokumenteninfosatz keine (noch</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>keine) Originaldokumente.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>2. Es existieren zwar Originaldokumente, aber durch eine Vorauswahl der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Workstationapplikationstypen wurden die Originaldokumente nicht</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selektiert.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYSTEM_RESPONSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die angezeigten Farbsymbole in der Liste repräsentieren verfügbare</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Zustände :</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,- grün</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,,,Originaldokumente verfügbar und slektiert.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,- gelb</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,,,Originaldokumente verfügbar aber nicht selektiert (siehe Vorauswahl</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Workstationapplikationstypen)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,- rot</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>,,,,keine Originaldokumente für Dokumenteninfosatz verfügbar</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;WHAT_TO_DO&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Sichern Sie ab, daß, falls notwendig, die entsprechenden</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Originaldateien nachgepflegt werden.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
       <TDLINE>Mit einem Doppelklick auf die Listenzeilen bzw. durch Druck auf den</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Button &quot;Anzeigen&quot; können Sie sich den zugehörigen Dokumenteninfosatz</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>ansehen.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>*</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYS_ADMIN&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
     </LINES>
    </item>
