     </DOKIL>
     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZCL_PLINT_MESSAGE_01200</TDNAME>
      <TDID>NA</TDID>
      <TDSPRAS>D</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00007</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;CAUSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Es wurden für ausgewählte Dokumenteninfosätze keine Originaldokumente</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>gefunden. Dies kann verschiedene Ursachen haben:</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>1. Es existieren für den gewählten Dokumenteninfosatz keine (noch</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>keine) Originaldokumente.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>2. Es existieren zwar Originaldokumente, aber durch eine Vorauswahl der</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Workstationapplikationstypen wurden die Originaldokumente nicht</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>selektiert.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;SYSTEM_RESPONSE&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Die angezeigten Farbsymbole in der Liste repräsentieren verfügbare</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>Zustände :</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,- grün</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,,,Originaldokumente verfügbar und slektiert.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,- gelb</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,,,Originaldokumente verfügbar aber nicht selektiert (siehe Vorauswahl</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>der Workstationapplikationstypen)</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,- rot</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>,,,,keine Originaldokumente für Dokumenteninfosatz verfügbar</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;WHAT_TO_DO&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Wählen Sie aus der angezeigten Listen die Dokumente aus für welche eine</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>erneute Suche durchgeführt werden soll. Und bestätigen Sie die Auswahl</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>mit der Taste &quot;OK&quot;.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Mit einem Doppelklick auf die Listenzeilen bzw. durch Druck auf den</TDLINE>
      </TLINE>
      <TLINE>
