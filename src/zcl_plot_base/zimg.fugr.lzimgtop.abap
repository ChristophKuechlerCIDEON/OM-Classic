DATA: PFAD(140),
      APPLIKATIONSNUMMER,
      APPLIKATIONSTYP,
      PROGRAM LIKE RLGRAP-FILENAME,
      PRG_PATH LIKE RLGRAP-FILENAME,
      COMMANDLINE(2500),
      DOKOB_D(2),
      DOKOB_T(2),
      DOKOB_E(2),
      DOKOB_M(2),
      DOKOB_W(2),
      APP_NAM(30).
